# Ignore everything by default (safeguard against accidental leaks)
/*

# Whitelist: the public repository content
!/.gitignore
!/.gitattributes
!/README.md
!/README.es.md
!/CHANGELOG.md
!/LICENSE
!/SKILL/
!/SKILL/**
!/.github/
!/.github/**

# Maintainer-internal: the regression suite and .agents/ are not published
SKILL/scripts/evals/**

# Operating system & temporary files
**/.DS_Store
**/Thumbs.db
**/*.swp
**/*.swo
**/*~
**/*.tmp
**/.idea/**
**/.vscode/**

# Python bytecode
**/__pycache__/
**/*.py[cod]

# Backups de sesiones concurrentes
**/*.bak
